{
  "name": "vision",
  "displayName": "vision",
  "description": "On-premise sLLM Coding Assistance and Intelligence",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:vision.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vision.helloWorld",
        "title": "Hello World"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "VisionAssistant",
          "title": "Vision Assistant ",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "VisionAssistant": [
        {
          "icon": "media/icon.svg",
          "type": "webview",
          "id": "VisionAssistant.sidebar",
          "name": " Overview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "vision.chat",
        "name": "vision",
        "fullName": "Vision Assistant",
        "description": "Ask Vision about your project",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
