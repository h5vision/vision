{
  "name": "vision",
  "displayName": "vision",
  "publisher": "Team-vision",
  "repository": {
    "type": "git",
    "url": "https://github.com/h5vision/vision.git"
  },
  "description": "On-premise sLLM Coding Assistance and Intelligence",
  "version": "0.1.5",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "vision",
      "properties": {
        "vision.endpoint": {
          "type": "string",
          "default": "http://44.208.79.122:8200",
          "description": "vision backendAI endpoint"
        },
        "vision.modelId": {
          "type": "string",
          "default": "backandai-default",
          "description": "vision backendAI modelId"
        },
        "vision.projectId": {
          "type": "string",
          "default": "None",
          "description": "vision projectId for sLLM RAG"
        },
        "vision.commitId": {
          "type": "string",
          "default": "None",
          "description": "vision commitId for selected project"
        },
        "vision.showGuideBook": {
          "type": "boolean",
          "default": false,
          "description": "Show guidebook when extension is activated"
        },
        "vision.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable sLLM answer streaming"
        }
      }
    },
    "commands": [
      {
        "command": "vision.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vision.explainFile",
        "title": "vision: 이 코드 설명해줘"
      },
      {
        "command": "vision.openDBExternal",
        "title": "vision: Open DB Location"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vision.explainFile",
          "group": "navigation",
          "when": "editorHasSelection || editorTextFocus"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "VisionAssistant",
          "title": "Vision Assistant ",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "icon": "media/icon.svg",
          "id": "visionFileView",
          "name": "< V > File Dependency",
          "type": "tree"
        }
      ],
      "VisionAssistant": [
        {
          "icon": "media/icon.svg",
          "type": "webview",
          "id": "VisionAssistant.sidebar",
          "name": " Overview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "vision.chat",
        "name": "vision",
        "fullName": "Vision Assistant",
        "description": "Ask Vision about your project",
        "isSticky": true,
        "commands": [
          {
            "name": "brief",
            "description": "프로젝트 브리핑을 생성합니다. "
          },
          {
            "name": "no-rag",
            "description": "RAG 기능을 사용하지 않습니다."
          },
          {
            "name": "indexing",
            "description": "Server DB에 인덱싱을 수행합니다."
          }
        ]
      }
    ]
  },
  "scripts": {
    "copy-assets": "node scripts/copy-assets.js",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run copy-assets && tsc -p ./",
    "watch": "npm run copy-assets && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
